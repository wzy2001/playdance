<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base theme. The window background is the splash artwork so the very first
      frame already shows the loading screen (all API levels). The activity then
      switches to the Compose content once it is ready.
    -->
    <style name="Theme.Dance" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
